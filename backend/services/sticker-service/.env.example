APP_NAME=sticker-service
APP_ENV=development

HTTP_PORT=8092
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=120s

DB_HOST=localhost
DB_PORT=5432
DB_NAME=sticker_service_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSLMODE=disable
DB_MAX_CONNS=20
DB_MIN_CONNS=2
DB_MAX_CONN_IDLE=5m
DB_MAX_CONN_LIFETIME=1h

LOG_LEVEL=info

INTERNAL_SERVICE_TOKEN=change-me
TRUSTED_GATEWAY_HEADER_USER_ID=X-User-Id
TRUSTED_GATEWAY_HEADER_ROLES=X-User-Roles
TRUSTED_GATEWAY_HEADER_SUB=X-Auth-Subject
REQUEST_ID_HEADER=X-Request-Id

FILE_MANAGER_BASE_URL=http://localhost:8083
FILE_MANAGER_TIMEOUT=5s
FILE_MANAGER_INTERNAL_SERVICE_TOKEN=

POST_MODERATION_ENABLED=true
STICKER_UPLOAD_SESSION_TTL=15m
