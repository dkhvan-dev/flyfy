APP_NAME=anti-fraud-service
APP_ENV=development

HTTP_PORT=8096
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=anti_fraud_service
POSTGRES_PASSWORD=anti_fraud_secret_dev
POSTGRES_DB=anti_fraud_service_db
POSTGRES_SSLMODE=disable
POSTGRES_MAX_OPEN_CONNS=10
POSTGRES_MIN_OPEN_CONNS=2
POSTGRES_MAX_CONN_LIFETIME=1h
POSTGRES_MAX_CONN_IDLE_TIME=30m

LOG_LEVEL=debug

INTERNAL_SERVICE_TOKEN=super-secret-internal-token

FRAUD_POLICY_VERSION=2026-05-29.v1
FRAUD_SHADOW_MODE=true
FRAUD_WINDOW=1h
FRAUD_OTP_SEND_PHONE_LIMIT=5
FRAUD_OTP_SEND_IP_LIMIT=25
FRAUD_OTP_VERIFY_PHONE_LIMIT=8
FRAUD_OTP_VERIFY_DEVICE_LIMIT=12
FRAUD_REFRESH_USER_LIMIT=120
FRAUD_PAYMENT_USER_LIMIT=20
FRAUD_HIGH_PAYMENT_AMOUNT_MINOR=1000000
FRAUD_PAYMENT_CURRENCY=KZT
FRAUD_UPLOAD_USER_LIMIT=60
FRAUD_UPLOAD_IP_LIMIT=250
FRAUD_SENSITIVE_DOCUMENT_REVIEW=true

FRAUD_ACTIVITY_CREATE_USER_LIMIT=10
FRAUD_ACTIVITY_JOIN_USER_LIMIT=30
FRAUD_ACTIVITY_CANCELLATION_USER_LIMIT=12
FRAUD_ACTIVITY_ATTENDANCE_USER_LIMIT=40
FRAUD_ACTIVITY_HIGH_RISK_AMOUNT_MINOR=500000

FRAUD_EXCURSION_PUBLISH_USER_LIMIT=8
FRAUD_EXCURSION_BOOKING_USER_LIMIT=20
FRAUD_EXCURSION_CANCEL_USER_LIMIT=10
FRAUD_EXCURSION_HIGH_RISK_AMOUNT_MINOR=750000
FRAUD_HIGH_PRICE_CHANGE_PERCENT=50
FRAUD_HIGH_PRICE_CHANGE_AMOUNT_MINOR=50000
FRAUD_REQUIRE_VERIFIED_GUIDE_TO_PUBLISH=true
