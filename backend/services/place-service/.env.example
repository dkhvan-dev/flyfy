APP_NAME=place-service
APP_ENV=development

HTTP_PORT=8090
GRPC_PORT=9099
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s

POSTGRES_HOST=localhost
POSTGRES_PORT=5441
POSTGRES_USER=place_service
POSTGRES_PASSWORD=place_secret_dev
POSTGRES_DB=place_service_db
POSTGRES_SSLMODE=disable
POSTGRES_MAX_CONNS=10
POSTGRES_MIN_CONNS=2

LOG_LEVEL=debug

PLACE_CACHE_ENABLED=true
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_CACHE_DB=4
PLACE_CACHE_KEY_PREFIX=place-service:cache:
PLACE_DETAIL_CACHE_TTL=15m
PLACE_LIST_CACHE_TTL=5m

INTERNAL_SERVICE_TOKEN=super-secret-internal-token
REQUIRE_AUTHENTICATED_WRITES=true
TRUSTED_GATEWAY_HEADER_USER_ID=X-User-Id
TRUSTED_GATEWAY_HEADER_ROLES=X-User-Roles
TRUSTED_GATEWAY_HEADER_SUB=X-Auth-Subject
REQUEST_ID_HEADER=X-Request-Id
SERVICE_AUTH_ISSUER=tourism-inflap/token-service
SERVICE_AUTH_JWKS_URL=http://localhost:8081/.well-known/jwks.json
SERVICE_AUTH_JWKS_CACHE_TTL=5m
# The Saved caller service account must have only the saved:resolve role for
# ResolveSaveEligibility. The gRPC service is internal and is not Gateway-routed.

USER_SERVICE_GRPC_TARGET=dns:///localhost:9094
FILE_MANAGER_GRPC_TARGET=dns:///localhost:9093
SAVED_COVER_FILE_MANAGER_TIMEOUT=3s

# Required in production. Development may disable dispatch while retaining
# transactional outbox rows for a later connected run.
SAVED_LIFECYCLE_EVENTS_ENABLED=false
NATS_URL=nats://localhost:4222
# Staging/production require tls:// plus mounted NATS user credentials and
# client mTLS material. Keep all paths empty for local plaintext development.
NATS_CREDS_PATH=
NATS_CA_CERT_PATH=
NATS_CLIENT_CERT_PATH=
NATS_CLIENT_KEY_PATH=
NATS_TLS_SERVER_NAME=
NATS_TLS_MIN_VERSION=1.3
# SAVED_SOURCE stream topology and limits are a shared producer contract and
# intentionally are not runtime-configurable by place-service.
SAVED_LIFECYCLE_NATS_CONNECT_TIMEOUT=3s
SAVED_LIFECYCLE_NATS_RECONNECT_WAIT=1s
SAVED_LIFECYCLE_BATCH_SIZE=50
SAVED_LIFECYCLE_CONCURRENCY=8
SAVED_LIFECYCLE_POLL_INTERVAL=500ms
SAVED_LIFECYCLE_LEASE_DURATION=2m
SAVED_LIFECYCLE_PUBLISH_TIMEOUT=3s
SAVED_LIFECYCLE_MAX_ATTEMPTS=20
SAVED_LIFECYCLE_RETRY_BASE=1s
SAVED_LIFECYCLE_RETRY_MAX=5m
SAVED_LIFECYCLE_CLEANUP_INTERVAL=1h
SAVED_LIFECYCLE_CLEANUP_BATCH=500
