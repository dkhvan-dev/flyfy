APP_NAME=chat-service
APP_ENV=development

HTTP_PORT=8088
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=120s
HTTP_IDLE_TIMEOUT=120s

GRPC_PORT=9097

DB_HOST=localhost
DB_PORT=5432
DB_NAME=chat_service_db
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSLMODE=disable
DB_MAX_CONNS=50
DB_MIN_CONNS=5

LOG_LEVEL=debug

INTERNAL_SERVICE_TOKEN=super-secret-internal-token
REQUIRE_AUTHENTICATED_WRITES=true

NATS_URL=nats://localhost:4222

REDIS_ADDR=localhost:6379
REDIS_DB=2

USER_SERVICE_GRPC_ADDR=user-service:9094
ACTIVITY_SERVICE_GRPC_ADDR=activity-service:9096

STICKER_SERVICE_HTTP_URL=http://sticker-service:8092
STICKER_SERVICE_TIMEOUT=5s
STICKER_SERVICE_INTERNAL_SERVICE_TOKEN=
