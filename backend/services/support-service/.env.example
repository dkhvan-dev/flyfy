APP_NAME=support-service
APP_ENV=development

SUPPORT_SERVICE_HTTP_PORT=8100
SUPPORT_SERVICE_HTTP_READ_TIMEOUT=5s
SUPPORT_SERVICE_HTTP_WRITE_TIMEOUT=10s
SUPPORT_SERVICE_HTTP_IDLE_TIMEOUT=60s

# Empty value keeps the local in-memory repository fallback.
# Production/stage should provide this via secrets/config management.
SUPPORT_SERVICE_DATABASE_URL=

# Optional trusted user context resolver. Leave URLs empty to run without
# user/guide-service dependencies; support tickets will use standard stale
# segment fallback until these are configured.
SUPPORT_SERVICE_USER_SERVICE_URL=
SUPPORT_SERVICE_GUIDE_SERVICE_URL=
SUPPORT_SERVICE_USER_CONTEXT_TIMEOUT=3s
SUPPORT_SERVICE_SEGMENT_REFRESH_INTERVAL=5m
