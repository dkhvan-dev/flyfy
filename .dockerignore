# VCS / IDE
.git
.gitignore
.idea
.agents
.omc
.goose
.vscode
.DS_Store
**/.DS_Store

# Flutter / mobile artifacts are not needed by backend Docker builds.
mobile/

# Local analysis, generated docs, and heavy non-runtime artifacts.
graphify-out/
docs/
*.jsx
*.pptx
*.docx
*.xlsx

# Generic dependency/build caches.
node_modules/
**/node_modules/
**/.dart_tool/
**/build/
**/bin/
**/.gocache/
**/.gradle/
**/coverage/
**/.pytest_cache/
**/__pycache__/
**/*.pyc

# Local env/log/temp files.
.env
*.log
tmp/
temp/

# Local secrets must never enter Docker build contexts.
**/run/secrets/
**/*service-account*.json
