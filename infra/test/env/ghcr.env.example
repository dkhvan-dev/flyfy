# Copy to /opt/inflap/env/ghcr.env only if deploying private GHCR images outside
# the GitHub Actions workflow. Prefer GitHub environment secrets:
# GHCR_USERNAME and GHCR_READ_TOKEN.
#
# Use the GitHub username that owns the token, not the organization namespace.
GHCR_USERNAME=change-me
GHCR_READ_TOKEN=change-me
