[Unit]
Description=Inflap test environment smoke check
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=deploy
Group=deploy
WorkingDirectory=/opt/inflap
Environment=APP_DIR=/opt/inflap
ExecStart=/opt/inflap/scripts/smoke-check.sh
StandardOutput=append:/var/log/inflap/smoke-check.log
StandardError=append:/var/log/inflap/smoke-check.log
